# Локальное состояние Obsidian; настройки навигации остаются в Git.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache/
.obsidian/graph.json

# Установленные плагины и их машинные настройки остаются на этом ПК.
.obsidian/community-plugins.json
.obsidian/plugins/

# Случайно созданное вложенное хранилище на другом устройстве.
/10 Учёба/.obsidian/
/10 Учёба/10 Учёба/

# Корзина, системные файлы и временные файлы аутентификации.
.trash/
.DS_Store
**/.DS_Store
Thumbs.db
.git_credentials_input*
obsidian_askpass.sh
